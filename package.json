{
  "scripts": {
    "dev": "npm run build:css && hugo server -D --disableFastRender",
    "build": "npm run build:css && hugo --gc --minify",
    "build:css": "tailwindcss -i ./assets/css/main.css -o ./static/css/main.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.17"
  }
}
